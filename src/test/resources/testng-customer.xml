<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Customer Module — TestNG Suite
  ═══════════════════════════════════════════════════════════════════════════
  Runs only CustomerTest. Extent Report is generated automatically.

  Run:
    mvn test -Pcustomer

  Extent Report output:
    target/extent-reports/ProjectW_TestReport_<timestamp>.html
-->
<suite name="Customer Module Test Suite" verbose="1" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.projectw.listeners.ExtentReportListener"/>
    </listeners>

    <test name="Customer Module API Tests">
        <classes>
            <class name="com.projectw.tests.CustomerTest"/>
        </classes>
    </test>

</suite>
